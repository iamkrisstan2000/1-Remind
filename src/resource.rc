#include <winver.h>

101 ICON "app.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "KnightWin"
            VALUE "Author",           "KnightWin"
            VALUE "FileDescription",  "1-Remind! - Hourly PC use reminder by KnightWin"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "1-Remind!"
            VALUE "LegalCopyright",   "Copyright (C) 2026 KnightWin. Licensed under GNU GPLv3."
            VALUE "OriginalFilename", "1-Remind!.exe"
            VALUE "ProductName",      "1-Remind!"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
